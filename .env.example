# App (public URLs only — safe for browser)
NEXT_PUBLIC_APP_URL=https://medflow.smartdeskai.cloud
NEXT_PUBLIC_N8N_URL=https://n8n.smartdeskai.cloud
TZ=America/Chicago

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medflow?schema=public"

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Phase 8 — Session & rate limits (HIPAA-conscious: use 1800 for 30-min sessions in production)
# SESSION_MAX_AGE_SECONDS=1800
# SESSION_UPDATE_AGE_SECONDS=900
# RATE_LIMIT_API_PER_MINUTE=120
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_WEBHOOK_PER_MINUTE=300

# Optional seed overrides (local dev only)
# SEED_ADMIN_EMAIL=admin@medflow.ai
# SEED_ADMIN_PASSWORD=Admin123!

# ---------------------------------------------------------------------------
# Phase 6 — Integrations (SERVER ONLY — never use NEXT_PUBLIC_* for secrets)
# Default: MOCK_MODE=true — no real SMS, calls, email, calendar, or AI traffic.
# ---------------------------------------------------------------------------

# Master switch — keep true for local development
MOCK_MODE=true

# Inbound webhook auth (MedFlow receives POSTs from n8n/partners)
WEBHOOK_SECRET=
# Legacy alias (optional): MEDFLOW_WEBHOOK_SECRET=

# Email
EMAIL_FROM=
SENDGRID_API_KEY=

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Twilio Voice + SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI voice (Vapi preferred when both set)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=

RETELL_API_KEY=
RETELL_AGENT_ID=

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Calendar (can share OAuth with Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# n8n — outbound webhook URLs (MedFlow POSTs when MOCK_MODE=false)
N8N_BASE_URL=https://n8n.smartdeskai.cloud
N8N_WEBHOOK_INBOUND_CALL=
N8N_WEBHOOK_OUTBOUND_CALL=
N8N_WEBHOOK_SMS=
N8N_WEBHOOK_EMAIL=
N8N_WEBHOOK_APPOINTMENT=
N8N_WEBHOOK_REMINDERS=
N8N_WEBHOOK_STAFF_INTERVENTION=

# Phase 7 — per-workflow n8n URLs (import JSONs from n8n-workflows/)
# N8N_WEBHOOK_REMINDER_48H=https://n8n.smartdeskai.cloud/webhook/medflow/reminder-48h
# N8N_WEBHOOK_REMINDER_24H=https://n8n.smartdeskai.cloud/webhook/medflow/reminder-24h
# N8N_WEBHOOK_REMINDER_2H=https://n8n.smartdeskai.cloud/webhook/medflow/reminder-2h
# N8N_WEBHOOK_REMINDER_30M=https://n8n.smartdeskai.cloud/webhook/medflow/reminder-30min
# N8N_WEBHOOK_WALK_IN=https://n8n.smartdeskai.cloud/webhook/medflow/walk-in-onboarding
# N8N_WEBHOOK_CHECK_IN=https://n8n.smartdeskai.cloud/webhook/medflow/physical-check-in
# N8N_WEBHOOK_AI_COORDINATION=https://n8n.smartdeskai.cloud/webhook/medflow/ai-coordination

# Local dev only — allow webhooks without WEBHOOK_SECRET (never in production)
# MEDFLOW_WEBHOOK_ALLOW_UNAUTHENTICATED=true

# Phase 5 voice mock behavior (when voice provider is in mock mode)
# REMINDER_VOICE_STUB_CONNECT=true
# REMINDER_VOICE_STUB_INTENT=NONE
