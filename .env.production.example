# MedFlow AI — production environment template (VPS / Docker)
# Copy to .env on the server — NEVER commit .env to Git.
# App: https://medflow.smartdeskai.cloud
# n8n (separate stack): https://n8n.smartdeskai.cloud

# ---------------------------------------------------------------------------
# Public URLs (safe for browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://medflow.smartdeskai.cloud
NEXT_PUBLIC_N8N_URL=https://n8n.smartdeskai.cloud
TZ=America/Chicago

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# With bundled PostgreSQL container (docker-compose.yml):
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/medflow?schema=public

# External PostgreSQL (remove postgres service from compose):
# DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/medflow?schema=public

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=medflow

# ---------------------------------------------------------------------------
# Auth (generate: openssl rand -base64 32)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=https://medflow.smartdeskai.cloud
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ---------------------------------------------------------------------------
# Master switch — keep true until integrations are deliberately enabled
# ---------------------------------------------------------------------------
MOCK_MODE=true

# ---------------------------------------------------------------------------
# Webhooks (MedFlow receives POSTs from n8n — server only)
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
# MEDFLOW_WEBHOOK_SECRET=  # optional alias

# ---------------------------------------------------------------------------
# n8n — outbound only; n8n container is NOT part of MedFlow compose
# ---------------------------------------------------------------------------
N8N_BASE_URL=https://n8n.smartdeskai.cloud
# N8N_WEBHOOK_INBOUND_CALL=
# N8N_WEBHOOK_OUTBOUND_CALL=
# N8N_WEBHOOK_SMS=
# N8N_WEBHOOK_EMAIL=
# N8N_WEBHOOK_APPOINTMENT=
# N8N_WEBHOOK_REMINDERS=
# N8N_WEBHOOK_STAFF_INTERVENTION=

# ---------------------------------------------------------------------------
# Docker runtime
# ---------------------------------------------------------------------------
RUN_MIGRATIONS_ON_START=true

# ---------------------------------------------------------------------------
# Optional integrations (leave empty while MOCK_MODE=true)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=
# EMAIL_FROM=

# ---------------------------------------------------------------------------
# Optional seed overrides (first deploy only — run: npx prisma db seed)
# ---------------------------------------------------------------------------
# SEED_ADMIN_EMAIL=admin@medflow.ai
# SEED_ADMIN_PASSWORD=CHANGE_ME_AFTER_FIRST_LOGIN

# NEVER set in production:
# MEDFLOW_WEBHOOK_ALLOW_UNAUTHENTICATED=true

# IANA timezone used for patient-facing dates in reminders (defaults to UTC)
CLINIC_TIMEZONE=America/New_York
