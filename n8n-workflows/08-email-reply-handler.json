            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "76b87a5a-f102-4946-865a-5c949631fb37",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
