      ]
    },
    {
      "parameters": {
        "content": "## MedFlow — Walk-In Onboarding\n\nWalk-in status sync template (no carrier sends).\n\n**Webhook path:** `medflow/walk-in-onboarding`\n**MedFlow env (outbound from MedFlow):** `N8N_WEBHOOK_WALK_IN`\n**Callback:** `POST /api/webhooks/staff-intervention`\n\nCreate intervention in MedFlow first; pass interventionId only.",
        "height": 280,
        "width": 400,
        "color": 5
      },
      "id": "f1e87b21-f812-4d94-8fbd-5bbe00edfe13",
      "name": "Workflow Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        140
      ]
    },
