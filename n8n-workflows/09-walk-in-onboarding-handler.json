            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "24c57262-9074-43ec-a40a-ea932e5467d9",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
