            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d8434f8d-37e0-4826-972d-557c9f82e9c6",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
