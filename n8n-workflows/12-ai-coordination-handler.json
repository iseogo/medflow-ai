            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "71986722-64bc-436a-9ddd-a67a9ea3bd24",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
