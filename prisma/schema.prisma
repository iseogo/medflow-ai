generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  MANAGER
  FRONT_DESK_STAFF
  BILLING_STAFF
  MEDICAL_RECORDS_STAFF
  CLINICAL_STAFF
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  CANCELLED
  CHECKED_IN
  WAITING
  WITH_PROVIDER
  COMPLETED
  WALK_OUT
  NO_SHOW
  FOLLOW_UP_NEEDED
}

enum WalkInVisitType {
  FIRST_TIME
  RETURNING
}

enum WalkInOnboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhysicalCheckInType {
  APPOINTMENT
  WALK_IN
}

enum WaitingRoomState {
  CHECKED_IN
  WAITING
  CALLED
  WITH_PROVIDER
  COMPLETED
  WALK_OUT
  NO_SHOW
}

enum StaffInterventionStatus {
  WALK_IN
  HUMAN_TAKEOVER
  AI_ESCALATED
  STAFF_REVIEW_REQUIRED
  RESOLVED
  FOLLOW_UP_NEEDED
  URGENT
}

enum StaffTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StaffTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  ANSWERED
  FAILED
  NO_ANSWER
  MISSED
  ABANDONED
  BOUNCED
  RESPONDED
  ESCALATED
}

enum CommunicationChannel {
  CALL
  SMS
  EMAIL
}

enum AgentType {
  MASTER_ORCHESTRATOR
  FRONT_DESK_AI
  INTAKE_AI
  APPOINTMENT_AI
  VOICE_CALL_AI
  SMS_REMINDER_AI
  EMAIL_AI
  STAFF_ASSISTANT_AI
  ESCALATION_AI
  SUPERVISOR_AI
}

enum AgentProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ESCALATED
  EXECUTED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum TimelineEventType {
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_STATUS_CHANGED
  CLIENT_CREATED
  CLIENT_UPDATED
  CONSENT_RECORDED
  STAFF_INTERVENTION_CREATED
  STAFF_INTERVENTION_UPDATED
  STAFF_TASK_CREATED
  STAFF_TASK_COMPLETED
  STAFF_OVERRIDE
  NOTE_ADDED
  SYSTEM
  COMMUNICATION_CALL
  COMMUNICATION_SMS
  COMMUNICATION_EMAIL
  AGENT_ACTION
  AGENT_PROPOSAL_CREATED
  AGENT_PROPOSAL_APPROVED
  AGENT_PROPOSAL_REJECTED
  AGENT_PROPOSAL_ESCALATED
  EMERGENCY_DETECTED
  WALK_IN_REGISTERED
  WALK_IN_ONBOARDING
  WALK_IN_COMPLETED
  PHYSICAL_CHECK_IN
  WAITING_ROOM_ARRIVED
  WAITING_ROOM_STATUS_CHANGED
  PROVIDER_NOTIFIED
  REMINDER_CYCLE_COMPLETED
  SUPERVISOR_ALERT
  WORKFLOW_HEALTH
  STAFF_NOTIFICATION
}

enum ConsentType {
  SMS
  EMAIL
  PHONE
  RECORDS_RELEASE
  TREATMENT
  MARKETING
}

// T-48h, T-24h, T-2h, T-30m before appointment
enum ReminderScheduleOffset {
  HOURS_48
  HOURS_24
  HOURS_2
  MINUTES_30
}

enum ReminderOutcome {
  CONFIRMED
  CANCELLED
  RESCHEDULE_REQUESTED
  NO_RESPONSE
  FAILED
  ESCALATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  STAFF_OVERRIDE
  VIEW
  EXPORT
  FILE_ACCESS
  SUPERVISOR_SCAN
}

enum AdminAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum WorkflowHealthStatus {
  HEALTHY
  DEGRADED
  FAILED
  STUCK
}

enum CoordinationIncidentType {
  DUPLICATE_ACTION
  CONFLICTING_ACTION
  UNAUTHORIZED_SEND
  MISSING_AUDIT
  MISSING_TIMELINE
  REMINDER_FAILURE
  WEBHOOK_FAILURE
  STUCK_WORKFLOW
  AGENT_VIOLATION
  ESCALATION_LOOP
  LOW_CONFIDENCE
  SCHEDULING_CONFLICT
  COMMUNICATION_INCONSISTENCY
  STAFF_OVERRIDE_VIOLATION
  EMERGENCY_RULE_VIOLATION
  AI_SAFETY_VIOLATION
  ORCHESTRATOR_ANOMALY
}

enum SupervisorRecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  DEFERRED
}

enum NotificationCategory {
  ACTION_REQUIRED
  URGENT
  EMERGENCY
  INFO
  SUCCESS
  WARNING
  SYSTEM
  AI_REVIEW
  SECURITY
  STAFF_OVERRIDE
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
  ESCALATED
}

enum NotificationSource {
  INBOUND_CALL_HUMAN_REVIEW
  MISSED_INBOUND_CALL
  OUTBOUND_CALL_FAILED
  REMINDER_FAILED
  PATIENT_CONFIRMED_APPOINTMENT
  PATIENT_CANCELLED_APPOINTMENT
  PATIENT_RESCHEDULE_REQUESTED
  PATIENT_NO_RESPONSE
  WALK_IN_ARRIVED
  CHECK_IN_COMPLETED
  WAITING_ROOM_DELAY
  PATIENT_WITH_PROVIDER
  APPOINTMENT_COMPLETED
  PATIENT_NO_SHOW
  STAFF_INTERVENTION_REQUIRED
  AI_LOW_CONFIDENCE
  EMERGENCY_RISK_DETECTED
  INSURANCE_PAYMENT_ISSUE
  MEDICAL_RECORDS_REQUEST
  WEBHOOK_FAILURE
  INTEGRATION_FAILURE
  SUPERVISOR_WARNING
  DUPLICATE_ACTION_PREVENTED
  STAFF_OVERRIDE_ACTIVATED
  WORKFLOW_STUCK
  AUDIT_SECURITY_WARNING
  MANUAL_STAFF
  ORCHESTRATOR_ESCALATION
}

model Role {
  id          String   @id @default(cuid())
  type        RoleType @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus           @default(ACTIVE)
  forcePasswordReset  Boolean              @default(false)
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastLoginAt         DateTime?
  passwordResetTokens PasswordResetToken[]
  staffNotifications  StaffNotification[]  @relation("NotificationAssignee")
  notificationPrefs NotificationPreference[]
  staffTasks          StaffTask[]          @relation("AssignedStaff")
  createdTasks        StaffTask[]          @relation("CreatedByUser")
  interventions       StaffIntervention[]  @relation("InterventionStaff")
  auditLogs           AuditLog[]           @relation("AuditActor")
  timelineEvents      ClientTimelineEvent[] @relation("TimelineActor")
  callLogs            CallLog[]            @relation("CallInitiator")
  smsLogs             SmsLog[]             @relation("SmsInitiator")
  emailLogs           EmailLog[]           @relation("EmailInitiator")
  agentActions         AgentAction[]        @relation("AgentActionInitiator")
  reviewedAgentActions AgentAction[]        @relation("AgentActionReviewer")
  staffOverrides       StaffOverride[]      @relation("StaffOverrideActor")
  walkInVisitsCreated  WalkInVisit[]        @relation("WalkInCreator")
  physicalCheckIns     PhysicalCheckIn[]    @relation("CheckInStaff")

  @@index([roleId])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                       String                @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String?
  phone                    String?
  dateOfBirth              DateTime?
  mrn                      String?               @unique
  notes                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  preferredLanguage        String?               @default("en")
  communicationPreferences Json?
  insurancePlaceholder     Json?
  documentsPlaceholder     Json?
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  appointments             Appointment[]
  staffTasks               StaffTask[]
  interventions            StaffIntervention[]
  timelineEvents           ClientTimelineEvent[]
  consentRecords           ConsentRecord[]
  callLogs                 CallLog[]
  smsLogs                  SmsLog[]
  emailLogs                EmailLog[]
  agentActions             AgentAction[]
  walkInVisits             WalkInVisit[]
  physicalCheckIns         PhysicalCheckIn[]
  waitingRoomEntries       WaitingRoomStatus[]
  reminderLogs             ReminderLog[]
  adminAlerts              AdminAlert[]
  coordinationIncidents    CoordinationIncident[]
  staffNotifications       StaffNotification[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
}

model Appointment {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  providerName    String?
  location        String?
  notes           String?
  staffOverride           Boolean           @default(false)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  callLogs                CallLog[]
  smsLogs         SmsLog[]
  emailLogs       EmailLog[]
  agentActions        AgentAction[]
  walkInVisits        WalkInVisit[]
  physicalCheckIns    PhysicalCheckIn[]
  waitingRoomEntries  WaitingRoomStatus[]
  reminderLogs        ReminderLog[]
  reminderAutomationPaused Boolean @default(false)

  @@index([clientId])
  @@index([scheduledAt])
  @@index([status])
  @@index([reminderAutomationPaused])
}

model WalkInVisit {
  id                      String                 @id @default(cuid())
  clientId                String
  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visitType               WalkInVisitType
  onboardingStatus        WalkInOnboardingStatus @default(IN_PROGRESS)
  onboardingStep          String?
  staffNotes              String?
  insurancePlaceholder    Json?
  documentsPlaceholder    Json?
  appointmentId           String?
  appointment             Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById             String
  createdBy               User                   @relation("WalkInCreator", fields: [createdById], references: [id])
  staffOverride           Boolean                @default(true)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  arrivedAt               DateTime               @default(now())
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  physicalCheckIns        PhysicalCheckIn[]

  @@index([clientId])
  @@index([onboardingStatus])
  @@index([arrivedAt])
}

model PhysicalCheckIn {
  id                    String              @id @default(cuid())
  clientId              String
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId         String?
  appointment           Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  walkInVisitId         String?
  walkInVisit           WalkInVisit?        @relation(fields: [walkInVisitId], references: [id], onDelete: SetNull)
  checkInType           PhysicalCheckInType
  arrivedAt             DateTime            @default(now())
  checkedInById         String
  checkedInBy           User                @relation("CheckInStaff", fields: [checkedInById], references: [id])
  notes                 String?
  staffOverride           Boolean             @default(true)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  waitingRoom           WaitingRoomStatus?

  @@index([clientId])
  @@index([appointmentId])
  @@index([arrivedAt])
}

model WaitingRoomStatus {
  id                  String           @id @default(cuid())
  physicalCheckInId   String           @unique
  physicalCheckIn     PhysicalCheckIn  @relation(fields: [physicalCheckInId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId       String?
  appointment         Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  state               WaitingRoomState @default(WAITING)
  queuePosition       Int?
  location            String?
  arrivedAt           DateTime
  calledAt            DateTime?
  withProviderAt      DateTime?
  completedAt         DateTime?
  walkOutAt           DateTime?
  waitDurationMinutes Int?
  providerNotifiedAt  DateTime?
  staffNotifiedAt     DateTime?
  staffOverride           Boolean          @default(true)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([clientId])
  @@index([appointmentId])
  @@index([state])
  @@index([arrivedAt])
}

model CallLog {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status          CommunicationStatus @default(PENDING)
  purpose         String
  channel         CommunicationChannel @default(CALL)
  direction       CallDirection
  phoneNumber     String?
  durationSeconds Int?
  externalRef     String?
  provider        String              @default("twilio_stub")
  transcript      String?
  metadata        Json?
  initiatedById   String?
  initiatedBy     User?               @relation("CallInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reminderLogsVoice ReminderLog[]

  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([clientId, appointmentId, purpose, channel])
}

model SmsLog {
  id            String              @id @default(cuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status        CommunicationStatus @default(PENDING)
  purpose       String
  channel       CommunicationChannel @default(SMS)
  toNumber      String?
  fromNumber    String?
  messageBody   String?
  externalRef   String?
  provider      String              @default("twilio_stub")
  metadata      Json?
  initiatedById String?
  initiatedBy   User?               @relation("SmsInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  reminderLogsSms ReminderLog[]

  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([clientId, appointmentId, purpose, channel])
}

model EmailLog {
  id            String              @id @default(cuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status        CommunicationStatus @default(PENDING)
  purpose       String
  channel       CommunicationChannel @default(EMAIL)
  subject       String?
  body          String?
  toEmail       String?
  fromEmail     String?
  externalRef   String?
  provider      String              @default("email_stub")
  metadata      Json?
  initiatedById String?
  initiatedBy   User?               @relation("EmailInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  reminderLogsEmail ReminderLog[]

  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([clientId, appointmentId, purpose, channel])
}

model AgentAction {
  id                String               @id @default(cuid())
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId     String?
  appointment       Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  agentType         AgentType              @default(ESCALATION_AI)
  proposalStatus    AgentProposalStatus    @default(PENDING_APPROVAL)
  purpose           String
  channel           CommunicationChannel
  actionType        String
  agentName         String                 @default("Legacy Agent")
  description       String?
  proposedPayload   Json?
  orchestratorNotes String?
  isEmergency       Boolean              @default(false)
  automationHalted        Boolean              @default(false)
  staffOverride           Boolean              @default(false)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  callLogId               String?
  smsLogId          String?
  emailLogId        String?
  metadata          Json?
  initiatedById     String?
  initiatedBy       User?                @relation("AgentActionInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  reviewedById      String?
  reviewedBy        User?                @relation("AgentActionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  executedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([clientId])
  @@index([appointmentId])
  @@index([proposalStatus])
  @@index([agentType])
  @@index([isEmergency])
  @@index([clientId, appointmentId, purpose, channel, agentType, actionType])
}

model StaffTask {
  id            String            @id @default(cuid())
  title         String
  description   String?
  status        StaffTaskStatus   @default(PENDING)
  priority      StaffTaskPriority @default(NORMAL)
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?             @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User              @relation("CreatedByUser", fields: [createdById], references: [id])
  dueAt         DateTime?
  completedAt   DateTime?
  staffOverride           Boolean           @default(true)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([clientId])
  @@index([assignedToId])
  @@index([status])
}

model StaffIntervention {
  id            String                  @id @default(cuid())
  clientId      String?
  client        Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status        StaffInterventionStatus
  title         String
  description   String?
  assignedToId  String?
  assignedTo    User?                   @relation("InterventionStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  staffOverride           Boolean                 @default(true)
  staffOverrideByUserId   String?
  staffOverrideByName     String?
  staffOverrideReason     String?
  staffOverrideAt         DateTime?
  aiContext               Json?
  resolvedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([assignedToId])
}

model StaffOverride {
  id           String   @id @default(cuid())
  actorUserId  String
  actor        User     @relation("StaffOverrideActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  actorName    String
  actorRole    RoleType
  targetType   String
  targetId     String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String?
  targetType  String?
  targetId    String?
  userId      String?
  user        User?       @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorName   String?
  actorRole   RoleType?
  clientId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([targetType, targetId])
  @@index([userId])
  @@index([actorUserId])
  @@index([clientId])
  @@index([createdAt])
}

model ClientTimelineEvent {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventType   TimelineEventType
  title       String
  description String?
  metadata    Json?
  actorUserId String?
  actor       User?             @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([clientId, createdAt])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       ConsentType
  granted    Boolean
  version    String      @default("1.0")
  recordedAt DateTime    @default(now())
  expiresAt  DateTime?
  notes      String?
  createdAt  DateTime    @default(now())

  @@index([clientId])
}

model ReminderLog {
  id               String                @id @default(cuid())
  appointmentId    String
  appointment      Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reminderOffset   ReminderScheduleOffset
  outcome          ReminderOutcome
  dueAt            DateTime
  voiceCallLogId   String?
  voiceCallLog     CallLog?              @relation(fields: [voiceCallLogId], references: [id], onDelete: SetNull)
  smsLogId         String?
  smsLog           SmsLog?               @relation(fields: [smsLogId], references: [id], onDelete: SetNull)
  emailLogId       String?
  emailLog         EmailLog?             @relation(fields: [emailLogId], references: [id], onDelete: SetNull)
  metadata         Json?
  createdAt        DateTime              @default(now())

  @@unique([appointmentId, reminderOffset])
  @@index([clientId])
  @@index([dueAt])
  @@index([outcome])
}

model AdminAlert {
  id               String             @id @default(cuid())
  severity         AdminAlertSeverity
  status           AdminAlertStatus   @default(OPEN)
  code             String
  title            String
  message          String
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  agentActionId    String?
  appointmentId    String?
  metadata         Json?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([severity])
  @@index([code])
  @@index([createdAt])
}

model WorkflowHealthEvent {
  id            String               @id @default(cuid())
  workflowKey   String
  status        WorkflowHealthStatus
  message       String?
  clientId      String?
  appointmentId String?
  agentActionId String?
  metadata      Json?
  recordedAt    DateTime             @default(now())

  @@index([workflowKey])
  @@index([status])
  @@index([recordedAt])
}

model AgentPerformanceMetric {
  id                 String    @id @default(cuid())
  agentType          AgentType
  periodStart        DateTime
  periodEnd          DateTime
  proposalsSubmitted Int       @default(0)
  proposalsApproved  Int       @default(0)
  proposalsRejected  Int       @default(0)
  proposalsEscalated Int       @default(0)
  violationsDetected Int       @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())

  @@unique([agentType, periodStart, periodEnd])
  @@index([agentType])
  @@index([periodStart])
}

model CoordinationIncident {
  id            String                   @id @default(cuid())
  incidentType  CoordinationIncidentType
  severity      AdminAlertSeverity
  title         String
  description   String?
  clientId      String?
  client        Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  agentActionId String?
  appointmentId String?
  resolved      Boolean                  @default(false)
  resolvedAt    DateTime?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([incidentType])
  @@index([resolved])
  @@index([createdAt])
}

model SupervisorRecommendation {
  id              String                         @id @default(cuid())
  status          SupervisorRecommendationStatus @default(PENDING)
  code            String
  title           String
  description     String
  correctiveAction String?
  clientId        String?
  agentActionId   String?
  incidentId      String?
  metadata        Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([status])
  @@index([code])
  @@index([createdAt])
}

model StaffNotification {
  id                    String               @id @default(cuid())
  title                 String
  message               String
  category              NotificationCategory
  priority              NotificationPriority
  status                NotificationStatus   @default(UNREAD)
  source                NotificationSource
  sourceKey             String
  recommendedNextAction String?
  clientId              String?
  client                Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointmentId         String?
  staffTaskId           String?
  agentActionId         String?
  adminAlertId          String?
  workflowKey           String?
  assignedRole          RoleType?
  assignedUserId        String?
  assignedUser          User?                @relation("NotificationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  staffInterventionId   String?
  metadata              Json?
  readAt                DateTime?
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  dismissedAt           DateTime?
  escalatedAt           DateTime?
  createdByUserId       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([sourceKey])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([assignedRole])
  @@index([assignedUserId])
  @@index([createdAt])
}

model NotificationPreference {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  minPriority  NotificationPriority @default(LOW)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
}
